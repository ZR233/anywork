{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywork.dev/schemas/run-export/v2/native.schema.json",
  "title": "原生完成事实和计费契约",
  "$defs": {
    "UsageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "reasoningTokens",
        "totalTokens"
      ],
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheReadTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWriteTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "amount"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        }
      }
    },
    "PricingOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "disabled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "noCharge"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unpriced"
            },
            "reason": {
              "enum": [
                "missingUsage",
                "invalidUsage",
                "missingPrice",
                "missingCacheUsage",
                "unsupportedServiceTier"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cost",
            "cacheSavings"
          ],
          "properties": {
            "kind": {
              "const": "estimated"
            },
            "cost": {
              "$ref": "#/$defs/Cost"
            },
            "cacheSavings": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cost"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "ModelPricingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputPerMtok": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputPerMtok": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheReadPerMtok": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWritePerMtok": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InferenceAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage",
        "pricing",
        "priceSnapshot",
        "requestStartedAt"
      ],
      "properties": {
        "usage": {
          "$ref": "#/$defs/UsageReport"
        },
        "pricing": {
          "$ref": "#/$defs/PricingOutcome"
        },
        "priceSnapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelPricingSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestStartedAt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ModelObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuredModel",
        "sentModel"
      ],
      "properties": {
        "configuredModel": {
          "type": "string"
        },
        "sentModel": {
          "type": "string"
        },
        "reportedModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InferenceTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstOutputSource"
      ],
      "properties": {
        "firstOutputSource": {
          "enum": [
            "unobserved",
            "incremental",
            "completedToolInput",
            "legacyUnknown"
          ]
        },
        "ttftMillis": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "decodeMillis": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "responseMillis": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "toolSchemaEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "toolResultEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "parallelCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "actualParallelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "toolBatchElapsedMillis": {
          "type": "integer",
          "minimum": 0
        },
        "toolExecutionMillis": {
          "type": "integer",
          "minimum": 0
        },
        "toolCriticalPathMillis": {
          "type": "integer",
          "minimum": 0
        },
        "toolCacheHits": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateSuppressed": {
          "type": "integer",
          "minimum": 0
        },
        "programCount": {
          "type": "integer",
          "minimum": 0
        },
        "programToolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "transportAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "continuationAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "continuationUsed": {
          "type": "integer",
          "minimum": 0
        },
        "continuationInvalid": {
          "type": "integer",
          "minimum": 0
        },
        "httpFallbacks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InferenceBillingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inferenceId",
        "accounting",
        "recordedAt"
      ],
      "properties": {
        "inferenceId": {
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "accountId": {
          "type": "string"
        },
        "accountDisplayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelObservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextWindow": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "accounting": {
          "$ref": "#/$defs/InferenceAccounting"
        },
        "promptGeneration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "promptCachePolicy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefixChangedReason": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "promptScopeChanged",
                "accountChanged",
                "modelChanged",
                "baseInstructionsChanged",
                "globalInstructionsChanged",
                "modeRoleChanged",
                "skillCatalogChanged",
                "workspaceInstructionsChanged",
                "requestPropertiesChanged",
                "fixedPrefixChanged",
                "toolSchemaChanged",
                "contextCompacted",
                "contextAppended",
                "contextRecovered"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "orchestration": {
          "$ref": "#/$defs/Orchestration"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceTiming"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "type": "integer"
        }
      }
    },
    "ContentOwner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "itemId"
          ],
          "properties": {
            "kind": {
              "const": "item"
            },
            "itemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "domain",
            "id",
            "revision"
          ],
          "properties": {
            "kind": {
              "const": "current"
            },
            "domain": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockId",
            "memberKey"
          ],
          "properties": {
            "kind": {
              "const": "displayObservation"
            },
            "blockId": {
              "type": "string"
            },
            "memberKey": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ContentTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "itemId"
          ],
          "properties": {
            "kind": {
              "const": "itemPayload"
            },
            "itemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "body"
            },
            "owner": {
              "$ref": "#/$defs/ContentOwner"
            },
            "key": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ContentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseId",
        "target"
      ],
      "properties": {
        "databaseId": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ContentTarget"
        }
      }
    },
    "PayloadData": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bytes"
          ],
          "properties": {
            "kind": {
              "const": "inline"
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "byteLength"
          ],
          "properties": {
            "kind": {
              "const": "deferred"
            },
            "reference": {
              "$ref": "#/$defs/ContentRef"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "ChatSourceId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "turnId"
          ],
          "properties": {
            "kind": {
              "const": "foregroundTurn"
            },
            "turnId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputId"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "inputId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceId",
            "messageId"
          ],
          "properties": {
            "kind": {
              "const": "inboxMessage"
            },
            "sourceId": {
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "messageId"
          ],
          "properties": {
            "kind": {
              "const": "backgroundResult"
            },
            "messageId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId"
          ],
          "properties": {
            "kind": {
              "const": "operation"
            },
            "operationId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receiptId"
          ],
          "properties": {
            "kind": {
              "const": "receipt"
            },
            "receiptId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ChatFactPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectSeq",
        "suborder"
      ],
      "properties": {
        "effectSeq": {
          "type": "integer",
          "minimum": 0
        },
        "suborder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatAtomLifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "started",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "active"
            },
            "started": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChatFactPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "running",
                "waiting"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "started",
            "ended",
            "outcome"
          ],
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "started": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChatFactPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ended": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChatFactPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "transferred"
              ]
            }
          }
        }
      ]
    },
    "ChatAtomContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reference"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "reasoningSummary",
            "toolArguments",
            "toolOutput"
          ]
        },
        "reference": {
          "$ref": "#/$defs/ContentRef"
        }
      }
    },
    "ChatAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "completionItemId",
        "completionSeq",
        "source",
        "sourceOrder",
        "kind",
        "delivery",
        "lifecycle",
        "turnId",
        "attemptId",
        "tool",
        "textChannel",
        "startedAt",
        "finishedAt",
        "contents",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "completionItemId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completionSeq": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/ChatSourceId"
        },
        "sourceOrder": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "input",
            "text",
            "reasoning",
            "toolCall",
            "fileChange",
            "skill",
            "interaction",
            "plan",
            "compaction",
            "turnReceipt",
            "receipt",
            "raw",
            "agent",
            "inference",
            "unknown"
          ]
        },
        "delivery": {
          "enum": [
            "foreground",
            "backgroundHandoff",
            "independent"
          ]
        },
        "lifecycle": {
          "$ref": "#/$defs/ChatAtomLifecycle"
        },
        "turnId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "callId",
                "name"
              ],
              "properties": {
                "callId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "textChannel": {
          "anyOf": [
            {
              "enum": [
                "user",
                "parentAgent",
                "commentary",
                "final"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentPresent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChatAtomContent"
          }
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadData"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ModelUsageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "contextWindow"
      ],
      "properties": {
        "routeIdentity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "contextWindow": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "maxContextWindow": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "autoCompactLimit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "UsageIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "enum": [
            "input",
            "output",
            "cacheRead",
            "cacheWrite",
            "reasoning",
            "total",
            "inferenceCount",
            "cachePair",
            "throughputPair"
          ]
        },
        "reason": {
          "enum": [
            "unreported",
            "inconsistent",
            "overflow"
          ]
        }
      }
    },
    "UsageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "callId",
        "turnId",
        "effectSequence",
        "observedAt",
        "purpose",
        "outcome"
      ],
      "properties": {
        "threadId": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "turnId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
