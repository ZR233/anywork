{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywork.dev/schemas/run-export/v2/run.schema.json",
  "title": "RunManifestV2",
  "description": "Immutable startup manifest written atomically to run.json before StudioRuntime initialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "startedAt",
    "build",
    "invocation",
    "skillSearch",
    "configInputs",
    "exportSchema"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "startedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "build": {
      "$ref": "#/$defs/BuildInfoV2"
    },
    "invocation": {
      "$ref": "#/$defs/RunInvocationV2"
    },
    "skillSearch": {
      "$ref": "#/$defs/SkillSearchManifestV2"
    },
    "configInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConfigInputEntryV2"
      }
    },
    "exportSchema": {
      "$ref": "#/$defs/ExportSchemaV2"
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "BuildInfoV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "gitCommit", "target"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "gitCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "RunInvocationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "studioHome",
        "accountId",
        "modelId",
        "reasoningEffort",
        "mode",
        "maxModelSteps",
        "promptSha256"
      ],
      "properties": {
        "cwd": { "type": "string", "minLength": 1 },
        "studioHome": { "type": "string", "minLength": 1 },
        "accountId": { "type": ["string", "null"] },
        "modelId": { "type": ["string", "null"] },
        "reasoningEffort": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "maxModelSteps": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "promptSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "SkillSearchManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeDefaultUserDir",
        "additionalDirs",
        "externalDirs",
        "systemEnabled",
        "skillsEnabled"
      ],
      "properties": {
        "includeDefaultUserDir": { "type": "boolean" },
        "additionalDirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalDirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "systemEnabled": { "type": "boolean" },
        "skillsEnabled": { "type": "boolean" }
      }
    },
    "ConfigInputEntryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalName", "present", "sha256", "redactedSummary"],
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256Hex" },
            { "type": "null" }
          ]
        },
        "redactedSummary": {}
      }
    },
    "ExportSchemaV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "events", "result", "contentAddressing"],
      "properties": {
        "manifest": { "const": 2 },
        "events": { "const": 2 },
        "result": { "const": 2 },
        "contentAddressing": { "const": "sha256" }
      }
    }
  }
}
